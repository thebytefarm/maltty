{
  "name": "@maltty/stories",
  "version": "1.0.0-rc.5",
  "description": "Framework-independent component stories for React and Ink",
  "keywords": [
    "cli",
    "ink",
    "maltty",
    "react",
    "stories",
    "tui"
  ],
  "homepage": "https://github.com/thebytefarm/maltty/tree/main/packages/stories",
  "bugs": {
    "url": "https://github.com/thebytefarm/maltty/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebytefarm/maltty.git",
    "directory": "packages/stories"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --ignore-pattern node_modules",
    "lint:fix": "oxlint --fix --ignore-pattern node_modules",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@maltty/utils": "workspace:*",
    "es-toolkit": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "jiti": ">=2.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "jiti": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
